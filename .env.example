# ============================================================
# Переменные окружения «Карапуз API».
#
# Ни одна из них не обязательна: без них проект запускается и работает,
# просто пользователи живут в памяти инстанса и пропадают после
# перезапуска. Файл .env в репозиторий не попадает (см. .gitignore) —
# реальные значения храните только у себя и в настройках Vercel.
#
# Скопируйте себе:  cp .env.example .env
# ============================================================

# --- Подпись токенов ----------------------------------------
# Длинная случайная строка. Пока её нет, ключ генерируется заново при
# каждом запуске, и выданные токены перестают действовать после
# перезапуска функции. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Сколько живёт токен: 30m, 2h, 7d или просто число секунд
JWT_EXPIRES_IN=2h

# --- База данных --------------------------------------------
# Пусто → пользователи хранятся в памяти (работает сразу, но после
# перезапуска регистрации пропадают).
# Заполнено → включается PostgreSQL, записи переживают деплой.
#
# Где взять строку бесплатно (5 шагов, ~3 минуты):
#   1. Откройте https://neon.tech и войдите через GitHub.
#   2. Create project → любое имя, регион поближе.
#   3. На экране проекта найдите Connection string.
#   4. Выберите вариант Pooled connection (важно для Vercel).
#   5. Скопируйте строку целиком — она начинается с postgresql://
#
# Ту же строку добавьте в Vercel: Project → Settings → Environment
# Variables → DATABASE_URL. После этого сделайте Redeploy.
#
# Тот же путь через Vercel: Storage → Create Database → Postgres —
# тогда переменная появится в проекте сама.
DATABASE_URL=

# Только если сервер базы с самоподписанным сертификатом: no-verify
DATABASE_SSL=

# --- Демонстрационный администратор -------------------------
# Заводится сам при первом запросе. Через него студенты пробуют
# методы, требующие роль admin. На своём сервере смените пароль.
ADMIN_EMAIL=admin@karapuz.tj
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Администратор Карапуз
ADMIN_TEL=+992900000000

# --- CORS ---------------------------------------------------
# * — открыть всем (значение по умолчанию).
# Список доменов через запятую — пускать только их и разрешить куки:
#   ALLOWED_ORIGINS=https://karapuz.tj,http://localhost:5173
ALLOWED_ORIGINS=*

# --- Ограничения размера ------------------------------------
MAX_BODY_BYTES=1048576
MAX_AVATAR_BYTES=262144

# --- Ограничение частоты запросов ---------------------------
# Окно в секундах и сколько запросов с одного адреса за это окно
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH=20
RATE_LIMIT_WRITE=120
RATE_LIMIT_READ=600

# --- Режим занятия ------------------------------------------
# true — POST/PUT/PATCH/DELETE работают без токена, как было раньше.
# Оставьте пустым: по умолчанию запись требует роль admin.
PUBLIC_WRITES=
