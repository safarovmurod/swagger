# ============================================================
# Переменные окружения «Карапуз API».
#
# Ни одна из них не обязательна: без них проект запускается и работает.
# Файл .env в репозиторий не попадает (см. .gitignore) — реальные
# значения храните только у себя и в настройках Vercel.
#
# Скопируйте себе:  cp .env.example .env
# ============================================================

# --- База данных --------------------------------------------
# Пусто → аккаунты хранятся в памяти инстанса (работает сразу, но после
# перезапуска функции регистрации пропадают).
# Заполнено → включается PostgreSQL, записи переживают деплой.
#
# Где взять строку бесплатно (5 шагов, ~3 минуты):
#   1. Откройте https://neon.tech и войдите через GitHub.
#   2. Create project → любое имя, регион поближе.
#   3. На экране проекта найдите Connection string.
#   4. Выберите вариант Pooled connection (важно для Vercel).
#   5. Скопируйте строку целиком — она начинается с postgresql://
#
# Ту же строку добавьте в Vercel: Project → Settings → Environment
# Variables → DATABASE_URL. После этого сделайте Redeploy.
DATABASE_URL=

# Только если сервер базы с самоподписанным сертификатом: no-verify
DATABASE_SSL=

# Сколько учебных аккаунтов держим. Когда регистраций становится больше,
# самые старые удаляются сами, чтобы база не росла бесконечно.
MAX_USERS=50

# --- Загрузка фотографий ------------------------------------
# Фото с телефона легко весит 5-10 МБ. Сервер принимает его целиком
# и сам сжимает в квадрат 512×512 — в базе лежат килобайты.
# Важно: на Vercel сама платформа не пропускает запрос больше 4.5 МБ.
# Это её ограничение, из кода его не обойти.
MAX_AVATAR_BYTES=10485760
MAX_BODY_BYTES=12582912

# --- Подпись токенов ----------------------------------------
# Нужны только в строгом режиме ADMIN_WRITES: обычные запросы работают
# без токена. Пока JWT_SECRET пуст, ключ генерируется заново при
# каждом запуске. Сгенерировать свой:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# --- Строгий режим ------------------------------------------
# По умолчанию пусто: POST/PUT/PATCH/DELETE работают без токена —
# это учебный тренажёр. ADMIN_WRITES=true возвращает старое поведение,
# когда менять данные может только администратор.
ADMIN_WRITES=

# Демонстрационный администратор заводится сам при первом запросе.
ADMIN_EMAIL=admin@karapuz.tj
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Администратор Карапуз
ADMIN_TEL=+992900000000

# --- CORS ---------------------------------------------------
# * — открыть всем (значение по умолчанию).
# Список доменов через запятую — пускать только их и разрешить куки:
#   ALLOWED_ORIGINS=https://karapuz.tj,http://localhost:5173
ALLOWED_ORIGINS=*

# --- Ограничение частоты запросов ---------------------------
# Окно в секундах и сколько запросов с одного адреса за это окно.
# Пределы свободные: за одним адресом может сидеть целая группа.
RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH=60
RATE_LIMIT_WRITE=300
RATE_LIMIT_READ=1200
